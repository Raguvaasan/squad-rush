# Copy to .env.local and fill in. Leave the Firebase values empty to play offline (no accounts or leaderboard).
# On Vercel, set the same variables in Project Settings > Environment Variables.

# Firebase web config (public by design: every VITE_* variable is shipped to the browser).
# The API also reads VITE_FIREBASE_PROJECT_ID to check sign-in tokens; that needs no service account key.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-only secrets, read only in api/ and server/. Never prefix these with VITE_.
MONGODB_URI=
# Optional; defaults to squad-rush.
MONGODB_DB=
