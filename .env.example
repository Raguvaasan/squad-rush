# Nothing here is used yet: Phase 1 is client-only.
# Phase 2 (accounts, coins, leaderboard) will need these. Copy to .env.local and fill in.

# Firebase web config (public by design: every VITE_* variable is shipped to the browser).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-only secrets, read only in api/. Never prefix these with VITE_.
MONGODB_URI=
FIREBASE_SERVICE_ACCOUNT_JSON=
